{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aqelacademy",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference binding used by OpenNext; must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "aqelacademy"
		}
	],
	"images": {
		// next/image optimization via Cloudflare Images (free: 5,000 unique transformations/month).
		"binding": "IMAGES"
	},
	// Runtime variables (SITE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, TURNSTILE_SITE_KEY)
	// are set in the Cloudflare dashboard; keep them across deploys.
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	// Serve only on the real domain. Cloudflare creates the DNS records on deploy,
	// so the old A/AAAA records for these hostnames must be deleted first.
	"routes": [
		{ "pattern": "aqelacademy.com", "custom_domain": true },
		{ "pattern": "www.aqelacademy.com", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": false
}
