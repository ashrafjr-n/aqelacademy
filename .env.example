# Copy to .env.local for `npm run dev`. On Cloudflare, set the same names as Worker variables.

# Public origin of the site (used in auth email links).
SITE_URL=http://localhost:3000

# Supabase project URL and publishable key (Project Settings → API Keys).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cloudflare Turnstile site key (the secret key goes to Supabase, not here).
TURNSTILE_SITE_KEY=0x0000000000000000000000
